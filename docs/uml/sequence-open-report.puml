@startuml
skinparam backgroundColor #ffffff
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #0f172a
skinparam sequence {
  ArrowColor #1e293b
  LifeLineBorderColor #334155
  LifeLineBackgroundColor #f8fafc
  ParticipantBorderColor #1e293b
  ParticipantBackgroundColor #f8fafc
  ParticipantFontColor #0f172a
  ActorBorderColor #1e293b
  ActorBackgroundColor #f8fafc
  ActorFontColor #0f172a
  BoxBorderColor #334155
  BoxBackgroundColor #f8fafc
  GroupBorderColor #334155
  GroupBackgroundColor #f8fafc
  GroupFontColor #0f172a
  DividerBorderColor #334155
  DividerBackgroundColor #e2e8f0
  DividerFontColor #0f172a
  ReferenceBorderColor #334155
  ReferenceBackgroundColor #f8fafc
  ReferenceFontColor #0f172a
  MessageFontColor #0f172a
  MessageAlign center
  ResponseMessageBelowArrow true
}
skinparam defaultFontSize 18
skinparam ParticipantPadding 24
skinparam BoxPadding 10
skinparam sequenceArrowThickness 2
skinparam sequenceMessageAlign direction
skinparam maxMessageSize 34
hide footbox
actor "Клиницист" as C
participant "Frontend" as FE
participant "API /reports/slide/{id}" as LIST
participant "API /reports/{id}" as DETAIL
participant "DB Service" as DB

C -> FE : Открывает раздел отчётов слайда
FE -> LIST : GET /api/reports/slide/{slide_id}
LIST -> DB : get_slide_reports(slide_id)
DB --> LIST : List<AnalysisReport>
LIST --> FE : success + report summaries
C -> FE : Выбирает отчёт
FE -> DETAIL : GET /api/reports/{report_id}
DETAIL -> DB : get_report_by_id(report_id)
DB --> DETAIL : AnalysisReport
DETAIL --> FE : success + detailed report
FE --> C : Отображение полного отчёта
@enduml
