@startuml
skinparam backgroundColor #ffffff
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #0f172a
skinparam sequence {
  ArrowColor #1e293b
  LifeLineBorderColor #334155
  LifeLineBackgroundColor #f8fafc
  ParticipantBorderColor #1e293b
  ParticipantBackgroundColor #f8fafc
  ParticipantFontColor #0f172a
  ActorBorderColor #1e293b
  ActorBackgroundColor #f8fafc
  ActorFontColor #0f172a
  BoxBorderColor #334155
  BoxBackgroundColor #f8fafc
  GroupBorderColor #334155
  GroupBackgroundColor #f8fafc
  GroupFontColor #0f172a
  DividerBorderColor #334155
  DividerBackgroundColor #e2e8f0
  DividerFontColor #0f172a
  ReferenceBorderColor #334155
  ReferenceBackgroundColor #f8fafc
  ReferenceFontColor #0f172a
  MessageFontColor #0f172a
  MessageAlign center
  ResponseMessageBelowArrow true
}
skinparam defaultFontSize 18
skinparam ParticipantPadding 20
skinparam BoxPadding 10
skinparam sequenceArrowThickness 2
skinparam sequenceMessageAlign direction
skinparam maxMessageSize 32
hide footbox
actor "Исследователь" as R
participant "Frontend" as FE
participant "API /slides/register" as API
participant "Orchestrator" as ORCH
participant "Gene Loader" as GENE
participant "WSI Loader" as WSI
participant "Boundary Adapter" as BOUND
participant "DB Service" as DB

R -> FE : Указывает project_id, patient_name, пути к TIFF/Parquet/HDF5
FE -> API : POST /api/slides/register
API -> ORCH : register_and_cache_slide(...)
ORCH -> ORCH : Проверка существования файлов
ORCH -> GENE : new XeniumGenePanelLoader(matrix_path)
ORCH -> WSI : new XeniumWSILoader(cells_path)
ORCH -> BOUND : new XeniumCellBoundaryAdapter(wsi_loader, gene_loader)
ORCH -> WSI : load_slide_metadata(tiff_path)
WSI --> ORCH : WSIContainer
ORCH -> WSI : apply_registration_to_dataframe()
ORCH -> DB : register_xenium_slide(..., metadata)
DB --> ORCH : XeniumSlide
ORCH -> ORCH : slides_cache[slide_id] = {loaders, metadata, db_record}
ORCH --> API : slide_id
API --> FE : success + slide_id
@enduml
